#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load homebox

	local enabled host port
	config_get_bool enabled main enabled 0
	config_get host main host "0.0.0.0"
	config_get port main port "3300"

	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/homebox serve --host "$host" --port "$port"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "homebox"
}
